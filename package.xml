<?xml version="1.0"?>
<package format="3">
  <name>spite_d</name>
  <version>0.1.0</version>
  <description>
    SPITE-D on a real robot: certifies roadmap edges against tracked,
    predicted moving obstacles from a depth camera. Trimmed build of the
    research package -- no roadmap generation, ablation tooling or tests.
  </description>
  <maintainer email="saigayathri.prakash@gmail.com">Sai</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>libopencv-dev</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
